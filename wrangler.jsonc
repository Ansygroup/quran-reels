{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quran-reels",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [{ "binding": "KV", "id": "dd82da751dee4191a82383f1574d472d" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/css/*", "!/js/*", "!/img/*", "!/fonts/*", "!/data/*"]
  }
}
